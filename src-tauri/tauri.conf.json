{
  "productName": "Teacha",
  "version": "0.2.0",
  "identifier": "com.teacha.app",
  "build": {
    "beforeDevCommand": "npx --yes serve src -l 1420",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": ""
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Teacha",
        "url": "index.html",
        "width": 1100,
        "height": 750,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "devtools": false
      }
    ]
  }
}
